# Copy to .env and fill in. .env is gitignored and must never be committed.
# Raises the NCBI Entrez rate limit from 3 to 10 requests/sec.
# Obtain one at https://account.ncbi.nlm.nih.gov/settings/
NCBI_API_KEY=

# Scratch space for BLAST databases, SRA extraction and alignment temp files.
# MUST be fast local disk, never a network or mounted Windows drive.
ACOMYS_SCRATCH=
