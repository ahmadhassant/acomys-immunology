# ==============================================================================
# Results - figures and tables ARE committed alongside the code that made them.
# Large intermediates are not.
# ==============================================================================
results/**/*.pkl
results/**/*.npy
results/**/*.h5
logs/

# ==============================================================================
# Large artefacts that the existing patterns did NOT catch.
# Audited 22 Aug 2026: without these, `git add .` would have staged 110 GB.
# ==============================================================================

# SRA extraction temp. `*.tmp` does not match a DIRECTORY named
# `fasterq.tmp.<HOST>.<PID>`, and fasterq-dump leaves these behind when it is
# interrupted. There were 101 GB of them in this working tree.
fasterq.tmp.*/
*.sra.tmp

# AnnData. `*.h5` does not match `.h5ad` - these were 2.3 GB.
*.h5ad
*.loom

# Reference downloads not under the paths listed above
data/reference/nguyen2023/
*.2bit
*.gff3
*.gtf
*.gff

# Superseded working copies
Old data/
data.zip

# ==============================================================================
# NEVER commit
# ==============================================================================
.env
.env.*
!.env.example
*api_key*
*.key
*.pem
*_token*

